# AtlasX Docker 部署（由 setup.sh 生成正式 .env；勿把 PAT/密钥提交进 git）
#
# ATLASX_RELEASE=0 → 使用 docker-compose.mvp.yml（旁路 ../AtlasX build）
# ATLASX_RELEASE=1 → 使用 docker-compose.yml（pull 预构建镜像）

ATLASX_RELEASE=0
ATLASX_IMAGE=ghcr.io/yingfff123/atlasx-docker
ATLASX_IMAGE_TAG=mvp

# 绝对路径由 setup.sh 写入（供 mvp build context）
ATLASX_ROOT=
ATLASX_DOCKER_ROOT=

POSTGRES_USER=radar
POSTGRES_PASSWORD=radar
POSTGRES_DB=radar

# host 必须是 compose 服务名 db
RADAR_DATABASE_URL=postgresql+psycopg://radar:radar@db:5432/radar
RADAR_MASTER_KEY=
# setup 会生成随机 token；映射 0.0.0.0:8000 时必填
RADAR_ACCESS_TOKEN=

RADAR_LLM_PROVIDER=none
