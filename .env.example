# AtlasX Docker 部署（setup.sh 生成正式 .env；勿提交密钥）
# 小内存可叠加: docker compose -f docker-compose.yml -f docker-compose.lite.yml up -d
# setup.sh 按 CPU 写入 ATLASX_IMAGE_TAG：amd64→0.2.8，arm64→0.2.8-arm64
# 海外可将 ATLASX_IMAGE 改为 ghcr.io/yingfff123/atlasx-docker

ATLASX_IMAGE=ghcr.1ms.run/yingfff123/atlasx-docker
ATLASX_IMAGE_TAG=0.2.8
POSTGRES_IMAGE=docker.m.daocloud.io/library/postgres:16
ATLASX_HTTP_PORT=8000

# setup.sh 写入
ATLASX_DOCKER_ROOT=

POSTGRES_USER=radar
POSTGRES_PASSWORD=radar
POSTGRES_DB=radar

# host 必须是 compose 服务名 db
RADAR_DATABASE_URL=postgresql+psycopg://radar:radar@db:5432/radar
RADAR_DEFAULT_ADMIN_USER=adminx
RADAR_DEFAULT_ADMIN_PASSWORD=Atlasx123!@#
RADAR_MASTER_KEY=
RADAR_ACCESS_TOKEN=

# web 与 worker 必须相同；setup 生成 atlasx-<random>
RADAR_MACHINE_ID=

# RADAR_SCAN_CONCURRENCY=2
# RADAR_LICENSE_SERVER=
# RADAR_LICENSE_API_KEY=
# RADAR_UPDATE_CHANNEL_URL=https://cdn.jsdelivr.net/gh/yingfff123/AtlasX-updates@main/channel.json
