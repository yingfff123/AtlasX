# AtlasX Docker 部署（由 setup.sh 生成正式 .env；勿把 PAT/密钥提交进 git）
#
# ATLASX_RELEASE=1 → docker-compose.yml（pull 预构建镜像，公开安装默认）
# ATLASX_RELEASE=0 → docker-compose.mvp.yml（旁路主仓 build）
# 小内存可叠加: docker compose -f docker-compose.yml -f docker-compose.lite.yml up -d

ATLASX_RELEASE=1
ATLASX_IMAGE=ghcr.io/yingfff123/atlasx
ATLASX_IMAGE_TAG=secure
ATLASX_HTTP_PORT=8000

# 绝对路径由 setup.sh 写入（供 mvp build context）
ATLASX_ROOT=
ATLASX_DOCKER_ROOT=

POSTGRES_USER=radar
POSTGRES_PASSWORD=radar
POSTGRES_DB=radar

# host 必须是 compose 服务名 db
RADAR_DATABASE_URL=postgresql+psycopg://radar:radar@db:5432/radar
RADAR_MASTER_KEY=
# setup 会生成随机 token；映射 0.0.0.0:8000 时必填
RADAR_ACCESS_TOKEN=

# 【必填】web 与 worker 共用同一值。setup 会生成 atlasx-<random>
# 未设时各容器 hostname 不同 → License 绑定分裂
RADAR_MACHINE_ID=

# 引擎热更目录（compose 已注入；与 volume atlasx_engine 对齐）
# RADAR_ENGINE_DIR=/var/atlasx/engine

# 可选
# RADAR_SCAN_CONCURRENCY=2
# RADAR_LICENSE_SERVER=
# RADAR_LICENSE_API_KEY=
# RADAR_UPDATE_CHANNEL_URL=https://cdn.jsdelivr.net/gh/yingfff123/AtlasX-updates@main/channel.json
